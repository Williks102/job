rules_version = '2';

service cloud.firestore {
    match /databases/{database}/documents {
          // IMPORTANT : Règles spécifiques EN PREMIER
              match /jobs/{jobId} {
                      allow read: if true;
                            allow write: if request.auth != null;
              }

                  // Règle par défaut pour toutes les AUTRES collections
                      // (ne s'applique PAS à /jobs car règle spécifique ci-dessus)
                          match /{collection}/{document=**} {
                                  allow read, write: if request.auth != null;
                          }
    }
}
                          }
              }
    }
}