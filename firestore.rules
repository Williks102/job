rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Les offres d'emploi sont lisibles par tous les visiteurs.
    match /jobs/{jobId} {
      allow read: if true;
      // Seuls les utilisateurs authentifiés (les administrateurs) peuvent créer/modifier/supprimer des offres.
      allow write: if request.auth != null;
    }

    // Par défaut, restreindre l'accès à toutes les autres collections.
    // Cette règle ne s'appliquera pas à /jobs car une règle plus spécifique existe déjà.
    match /{path=**}/documents/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
